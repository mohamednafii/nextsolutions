# ── Public site facts (exposed to the browser). Leave empty to hide the element. ──
# Canonical origin, no trailing slash. Used for canonical URLs, hreflang, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# WhatsApp number in international format, digits only (e.g. 2126XXXXXXXX).
# Enables every "ou WhatsApp" / "Écrire sur WhatsApp" link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
# Legal notice (Mentions légales)
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_ADDRESS=

# ── Server only (never exposed). ──
# Where "Démarrer un projet" leads are POSTed as JSON (e.g. an n8n webhook).
# Without it the form shows an honest error instead of a fake success.
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=

# ── Development only ──
# Preview the project showcase/grid/detail layout with placeholder samples
# (never rendered in production builds).
# SHOW_DRAFT_PROJECTS=1
